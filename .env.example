# Application
APP_ENV=development
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30

# API
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://reviewpilot:reviewpilot@localhost:5432/reviewpilot

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_JOB_QUEUE=reviewpilot:jobs
REDIS_DLQ=reviewpilot:dlq

# GitHub App
GITHUB_WEBHOOK_SECRET=change-me-webhook-secret
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_INSTALLATION_ID=

# LLM (used in later phases)
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Review tuning
CONFIDENCE_THRESHOLD=0.5
MAX_COMMENTS_PER_PR=40
AGENT_TIMEOUT_SECONDS=90
AGENT_CONCURRENCY=4
TOKEN_BUDGET_PER_CHUNK=6000
